generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ProficiencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  UNKNOWN
}

enum LearningGoal {
  DAILY_CONVERSATION
  JOB_INTERVIEW
  BUSINESS_ENGLISH
  TRAVEL
  ACADEMIC
  CONFIDENCE
}

enum SessionStatus {
  CREATED
  CONNECTING
  ACTIVE
  COMPLETED
  FAILED
  INTERRUPTED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String?
  role            UserRole         @default(STUDENT)
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  profile         UserProfile?
  assessments     Assessment[]
  learningPaths   LearningPath[]
  lessonProgress  LessonProgress[]
  voiceSessions   VoiceSession[]
  memories        LearningMemory[]
  vocabulary      VocabularyItem[]
  learningEvents  LearningEvent[]
  subscription    Subscription?
  usageRecords    UsageRecord[]

  @@index([createdAt])
}

model UserProfile {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @unique @db.Uuid
  displayName         String
  nativeLanguage      String           @default("hi")
  targetLanguage      String           @default("en")
  explanationLanguage String           @default("hi")
  proficiencyLevel    ProficiencyLevel @default(UNKNOWN)
  dailyGoalMinutes    Int              @default(15)
  speakingSpeed       String           @default("NORMAL")
  learningGoals       LearningGoal[]
  timezone            String           @default("Asia/Kolkata")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  level        ProficiencyLevel
  overallScore Float?
  status       String
  createdAt    DateTime          @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  result AssessmentResult?

  @@index([userId, createdAt])
}

model AssessmentResult {
  id                 String   @id @default(uuid()) @db.Uuid
  assessmentId       String   @unique @db.Uuid
  grammarScore       Float?
  vocabularyScore    Float?
  fluencyScore       Float?
  pronunciationScore Float?
  listeningScore     Float?
  strengths          String[]
  weaknesses         String[]

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  title       String
  description String?
  level       ProficiencyLevel
  category    String
  content     Json
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  progress LessonProgress[]

  @@index([level, category, isPublished])
}

model LearningPath {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model LessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  lessonId    String    @db.Uuid
  completed   Boolean   @default(false)
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
}

model VoiceSession {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  status            SessionStatus    @default(CREATED)
  provider          String
  providerSessionId String?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int              @default(0)
  scenario          String?
  level             ProficiencyLevel?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  evaluation   SessionEvaluation?
  usageRecords UsageRecord[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  role      MessageRole
  content   String
  sequence  Int
  language  String      @default("en")
  metadata  Json?
  createdAt DateTime    @default(now())

  session VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
}

model SessionEvaluation {
  id                 String           @id @default(uuid()) @db.Uuid
  sessionId          String           @unique @db.Uuid
  status             EvaluationStatus @default(PENDING)
  grammarScore       Float?
  vocabularyScore    Float?
  fluencyScore       Float?
  pronunciationScore Float?
  summary            String?
  strengths          Json?
  weaknesses         Json?
  corrections        Json?
  nextActions        Json?
  evaluatedAt        DateTime?

  session VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LearningEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  eventType  String
  category   String
  payload    Json
  occurredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, occurredAt])
}

model VocabularyItem {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  word         String
  meaning      String
  example      String?
  masteryLevel Float     @default(0)
  nextReviewAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, nextReviewAt])
}

model LearningMemory {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  memoryType String
  content    Json
  confidence Float?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, memoryType])
}

model Plan {
  id                     String  @id @default(uuid()) @db.Uuid
  name                   String  @unique
  monthlyPrice           Int
  dailyVoiceLimitSeconds Int
  features               Json
  isActive               Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus
  startsAt               DateTime
  endsAt                 DateTime?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

model UsageRecord {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  sessionId     String?  @db.Uuid
  usageType     String
  quantity      Float
  unit          String
  provider      String?
  model         String?
  estimatedCost Decimal? @db.Decimal(12, 6)
  recordedAt    DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session VoiceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([sessionId])
}
